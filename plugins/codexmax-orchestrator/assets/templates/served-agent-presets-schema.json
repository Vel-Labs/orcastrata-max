{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexmax.local/schemas/served-agent-presets-v1.json",
  "title": "Served Agent Preset Bundle V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "bundle_id", "generation", "presets", "bundle_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_type": {"const": "served_agent_preset_bundle_v1"},
    "bundle_id": {"$ref": "#/$defs/identifier"},
    "generation": {"type": "integer", "minimum": 1},
    "presets": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/preset"}},
    "bundle_sha256": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset_id", "family_id", "role", "instructions_sha256", "route", "adapter", "policy", "limits", "metadata_allowlist"],
      "properties": {
        "preset_id": {"$ref": "#/$defs/identifier"},
        "family_id": {"$ref": "#/$defs/identifier"},
        "role": {"$ref": "#/$defs/identifier"},
        "instructions_sha256": {"$ref": "#/$defs/digest"},
        "route": {
          "type": "object", "additionalProperties": false,
          "required": ["route_id", "model_id", "host_id"],
          "properties": {"route_id": {"$ref": "#/$defs/identifier"}, "model_id": {"$ref": "#/$defs/identifier"}, "host_id": {"$ref": "#/$defs/identifier"}}
        },
        "adapter": {
          "type": "object", "additionalProperties": false,
          "required": ["adapter_id", "action_id", "tool_id", "transport", "qualification_status"],
          "properties": {
            "adapter_id": {"$ref": "#/$defs/identifier"}, "action_id": {"$ref": "#/$defs/identifier"},
            "tool_id": {"$ref": "#/$defs/identifier"}, "transport": {"$ref": "#/$defs/identifier"},
            "qualification_status": {"const": "qualified"}
          }
        },
        "policy": {
          "type": "object", "additionalProperties": false,
          "required": ["policy_id", "active"],
          "properties": {"policy_id": {"$ref": "#/$defs/identifier"}, "active": {"const": true}}
        },
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["max_input_chars", "max_output_chars", "max_stream_events", "max_tool_refs"],
          "properties": {
            "max_input_chars": {"type": "integer", "minimum": 1, "maximum": 16384},
            "max_output_chars": {"type": "integer", "minimum": 1, "maximum": 16384},
            "max_stream_events": {"type": "integer", "minimum": 1, "maximum": 128},
            "max_tool_refs": {"type": "integer", "minimum": 1, "maximum": 16}
          }
        },
        "metadata_allowlist": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  }
}
