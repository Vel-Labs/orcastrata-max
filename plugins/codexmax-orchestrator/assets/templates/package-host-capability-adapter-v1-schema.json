{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codexmax.local/schemas/package-host-capability-adapter-v1.json",
  "oneOf": [{"$ref": "#/$defs/trust"}, {"$ref": "#/$defs/capabilities"}, {"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}, {"$ref": "#/$defs/recoveryGrant"}],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["workspace_id", "source_sha256", "candidate_sha256"], "properties": {"workspace_id": {"type": "string", "minLength": 1}, "source_sha256": {"$ref": "#/$defs/sha256"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}}},
    "operation": {"enum": ["verify_effect_authority", "invoke_registered_action", "issue_responses_context", "verify_responses_bridge", "read_capability_admission", "commit_or_verify_record", "seal_or_verify_projection", "open_operator_listener", "read_operator_supervision", "read_operator_preset_bundle", "read_operator_selection_head", "read_operator_selection_mutation", "commit_operator_selection", "read_operator_recovery_lease_grant"]},
    "trust": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_type", "configured", "test_only", "host_id", "socket_path", "expected_dns_san", "ca_pem_sha256", "tls_minimum", "protocol_version", "config_sha256"], "properties": {"schema_version": {"const": 1}, "artifact_type": {"const": "package_host_trust_v1"}, "configured": {"type": "boolean"}, "test_only": {"type": "boolean"}, "host_id": {"type": "string", "minLength": 1}, "socket_path": {"type": "string", "pattern": "^/"}, "expected_dns_san": {"type": "string", "minLength": 1}, "ca_pem_sha256": {"$ref": "#/$defs/sha256"}, "tls_minimum": {"const": "TLSv1.3"}, "protocol_version": {"const": 1}, "config_sha256": {"$ref": "#/$defs/sha256"}}},
    "registration": {"type": "object", "additionalProperties": false, "required": ["action_id", "tool_id", "transport", "parameter_fields"], "properties": {"action_id": {"type": "string", "minLength": 1}, "tool_id": {"type": "string", "minLength": 1}, "transport": {"type": "string", "minLength": 1}, "parameter_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "lease": {"type": "object", "additionalProperties": false, "required": ["lease_id", "fencing_token", "issued_at", "expires_at", "lease_sha256"], "properties": {"lease_id": {"type": "string", "minLength": 1}, "fencing_token": {"type": "integer", "minimum": 1}, "issued_at": {"type": "string"}, "expires_at": {"type": "string"}, "lease_sha256": {"$ref": "#/$defs/sha256"}}},
    "cas": {"type": "object", "additionalProperties": false, "required": ["expected_state_version", "expected_thread_generation"], "properties": {"expected_state_version": {"type": "integer", "minimum": 0}, "expected_thread_generation": {"type": "integer", "minimum": 0}}},
    "recoveryGrant": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_type", "grant_id", "issuer_id", "workspace_id", "source_sha256", "candidate_sha256", "service_instance_id", "admission_id", "binding_state_version", "binding_state_sha256", "selection_sha256", "predecessor_run_id", "predecessor_effect_request_sha256", "predecessor_effect_receipt_sha256", "reconciliation_receipt_sha256", "no_successor", "fresh_lease", "expected_cas", "reserved_authority_id", "issued_at", "expires_at", "grant_sha256", "seal"], "properties": {"schema_version": {"const": 1}, "artifact_type": {"const": "effect_kernel_recovery_lease_grant_v1"}, "grant_id": {"type": "string", "minLength": 1}, "issuer_id": {"type": "string", "minLength": 1}, "workspace_id": {"type": "string", "minLength": 1}, "source_sha256": {"$ref": "#/$defs/sha256"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "service_instance_id": {"type": "string", "minLength": 1}, "admission_id": {"type": "string", "minLength": 1}, "binding_state_version": {"type": "integer", "minimum": 1}, "binding_state_sha256": {"$ref": "#/$defs/sha256"}, "selection_sha256": {"$ref": "#/$defs/sha256"}, "predecessor_run_id": {"type": "string", "minLength": 1}, "predecessor_effect_request_sha256": {"$ref": "#/$defs/sha256"}, "predecessor_effect_receipt_sha256": {"$ref": "#/$defs/sha256"}, "reconciliation_receipt_sha256": {"$ref": "#/$defs/sha256"}, "no_successor": {"const": true}, "fresh_lease": {"$ref": "#/$defs/lease"}, "expected_cas": {"$ref": "#/$defs/cas"}, "reserved_authority_id": {"type": "string", "minLength": 1}, "issued_at": {"type": "string"}, "expires_at": {"type": "string"}, "grant_sha256": {"$ref": "#/$defs/sha256"}, "seal": {"$ref": "#/$defs/sha256"}}},
    "capabilities": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_type", "configured", "action_registrations", "capability_ids", "operation_mapping", "config_sha256"], "properties": {"schema_version": {"const": 1}, "artifact_type": {"const": "package_host_capabilities_v1"}, "configured": {"type": "boolean"}, "action_registrations": {"type": "array", "items": {"$ref": "#/$defs/registration"}}, "capability_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "operation_mapping": {"type": "object", "minProperties": 14, "maxProperties": 14}, "config_sha256": {"$ref": "#/$defs/sha256"}}},
    "request": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_type", "protocol_version", "session_nonce", "request_nonce", "operation", "identity", "body", "issued_at", "expires_at", "request_sha256"], "properties": {"schema_version": {"const": 1}, "artifact_type": {"const": "package_host_capability_request_v1"}, "protocol_version": {"const": 1}, "session_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "request_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "operation": {"$ref": "#/$defs/operation"}, "identity": {"$ref": "#/$defs/identity"}, "body": {"type": "object"}, "issued_at": {"type": "string"}, "expires_at": {"type": "string"}, "request_sha256": {"$ref": "#/$defs/sha256"}}},
    "response": {"type": "object", "additionalProperties": false, "required": ["schema_version", "artifact_type", "protocol_version", "session_nonce", "request_nonce", "operation", "identity", "body", "issued_at", "expires_at", "request_sha256", "response_sha256"], "properties": {"schema_version": {"const": 1}, "artifact_type": {"const": "package_host_capability_response_v1"}, "protocol_version": {"const": 1}, "session_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "request_nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "operation": {"$ref": "#/$defs/operation"}, "identity": {"$ref": "#/$defs/identity"}, "body": {}, "issued_at": {"type": "string"}, "expires_at": {"type": "string"}, "request_sha256": {"$ref": "#/$defs/sha256"}, "response_sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
