            },
            "raw_provider_output_excluded": {
              "const": true
            },
            "credentials_excluded": {
              "const": true
            },
            "auth_material_excluded": {
              "const": true
            },
            "private_environment_excluded": {
              "const": true
            },
            "secret_bearing_paths_excluded": {
              "const": true
            },
            "broker_write_authority_excluded": {
              "const": true
            },
            "goalbuddy_write_authority_excluded": {
              "const": true
            }
          }
        },
        "aol_admitted": {
          "const": false
        },
        "c50_accepted": {
          "const": false
        },
        "c60_accepted": {
          "const": false
        },
        "joined_execution": {
          "const": false
        },
        "product_accepted": {
          "const": false
        },
        "assurance_claimed": {
          "const": false
        },
        "economics_claimed": {
          "const": false
        },
        "home_now_truth_claimed": {
          "const": false
        },
        "broker_write_authority": {
          "const": false
        },
        "goalbuddy_write_authority": {
          "const": false
        },
        "provider_called": {
          "const": false
        },
        "network_used": {
          "const": false
        },
        "service_started": {
          "const": false
        },
        "installed": {
          "const": false
        },
        "published": {
          "const": false
        },
        "proposal_sha256": {
          "$ref": "#/$defs/sha256"
