    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest_algorithm",
        "canonicalization",
        "upstream_anchor_sha256",
        "overlay_policy_sha256",
        "divergence_ledger_sha256",
        "compatibility_sha256",
        "lifecycle_sha256",
        "external_mappings_sha256",
        "evidence_catalog_sha256",
        "handoff_sha256",
        "kit_sha256",
        "signature_state",
        "authenticity_claimed"
      ],
      "properties": {
        "digest_algorithm": {
          "const": "sha256"
        },
        "canonicalization": {
          "const": "sorted_ascii_no_floats_v1"
