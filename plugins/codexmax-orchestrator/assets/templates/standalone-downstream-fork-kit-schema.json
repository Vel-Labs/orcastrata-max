        "upstream_anchor_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "overlay_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "divergence_ledger_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "compatibility_sha256": {
          "$ref": "#/$defs/sha256"
