    "evidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "path",
        "sha256",
        "proof_scope",
        "grants_authority",
        "affects_routing",
        "proves_provider_qualification",
        "proves_protected_production",
        "proves_aol_admission"
      ],
      "properties": {
        "category": {
          "enum": [
            "installed_journey",
            "provider_dispatch",
            "compact_telemetry",
            "advisory_evaluation",
            "real_work_dogfood",
            "deferred_enterprise"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proof_scope": {
          "$ref": "#/$defs/identifier"
